# ─────────────────────────────────────────────────────────────────────────────
# Aegis — detection-half environment.   cp .env.example .env  then edit.
# Docker Compose auto-loads ./.env. The defaults below run a SINGLE-MACHINE demo
# out of the box (just `cp` and `detctl up`). The notes mark what to change for a
# TWO-MACHINE deployment (detection host + separate SOAR host).
# NEVER commit your real .env — it is gitignored (.env.example is the template).
# ─────────────────────────────────────────────────────────────────────────────

# ── Kafka (KRaft, single broker) ─────────────────────────────────────────────
# Internal services reach the broker at kafka:9092 (unchanged). The EXTERNAL
# listener (:9094) is only needed when the SOAR host / a remote endpoint sensor
# consumes Kafka across the network — then set this to THIS host's LAN IP, not
# localhost, or remote consumers get a localhost redirect and hang.
KAFKA_EXTERNAL_ADVERTISED_HOST=localhost          # TWO-MACHINE: set to the detection host IP
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,EXTERNAL://0.0.0.0:9094,CONTROLLER://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,EXTERNAL://${KAFKA_EXTERNAL_ADVERTISED_HOST:-localhost}:9094
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,EXTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_LOG_RETENTION_HOURS=24
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m

# ── SOAR approval bridge (dashboard → orchestrator) ──────────────────────────
# Only needed for the FULL closed loop (the separate SOAR repo + orchestrator).
# A detection-only demo runs fine without it (the Approvals page just stays empty).
#  • URL: the orchestrator's /soar/approve base. It serves plain HTTP → use http://
#    (https:// triggers [SSL: WRONG_VERSION_NUMBER]). Point at the SOAR host.
#  • TOKEN: a shared secret that MUST match the value in the SOAR repo's .env.
#    Generate one:  openssl rand -base64 32   (set the same string on both halves).
SOAR_APPROVAL_URL=http://SOAR_HOST_IP:8200
SOAR_APPROVAL_TOKEN=CHANGE_ME_shared_secret_must_match_the_SOAR_side
SOAR_APPROVAL_VERIFY_TLS=false

# ── Severity bands (advisory; keep aligned with the orchestrator) ─────────────
# The dashboard label uses these; the orchestrator is authoritative and uses the
# same bands. If the SOAR side retunes its thresholds, match them here + restart
# the translator (no code change). High ≥ HIGH_MIN, Medium ≥ MED_MIN, else Low.
SEVERITY_HIGH_MIN=0.80
SEVERITY_MED_MIN=0.70

# ── Simulation: replay-as-endpoint identity (optional) ───────────────────────
# When you run `detctl sim <AGENT_ID>`, replayed flows are stamped with this
# host's identity so the SOAR side can route a block/isolate back here. For a
# detection-only demo these are harmless. TWO-MACHINE: set HOST_IP to this host.
SIM_HOST_ID=detection-host
SIM_HOST_IP=127.0.0.1

# ── Endpoint NFStream sensor (only if you run endpoint_agent/sensor) ─────────
# The sensor compose reads this same .env. KAFKA_BROKER must be reachable from
# the endpoint (the detection host's EXTERNAL listener). INTERFACE empty = "any".
KAFKA_BROKER=localhost:9094
INTERFACE=
# AGENT_ID / HOST_ID / HOST_IP are filled by endpoint_agent/install.sh after Wazuh enrolment.

# ── Dashboard tunables (optional) ────────────────────────────────────────────
# REFRESH_INTERVAL_MS=20000        # WS-driven; this is the fallback poll
# CORS_ORIGINS=*                   # restrict in production
# WS_POLL_SEC=2                    # backend change-poller cadence
