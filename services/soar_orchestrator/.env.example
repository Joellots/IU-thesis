# ═══════════════════════════════════════════════════════════════════════════════
# SOAR Orchestrator — environment TEMPLATE.   cp .env.example .env   then fill in.
#
# The real .env is gitignored — NEVER commit it. Every secret below is a PLACEHOLDER.
# A fresh deployer edits ONLY this file (copied to .env). Two host placeholders to
# find-and-replace throughout:
#     <DETECTION_HOST> = LAN IP/DNS of the DETECTION machine (owns Postgres + Kafka)
#     <SOAR_HOST>      = LAN IP/DNS of THIS (SOAR) machine (runs the SOAR stack)
# Then fill the keys, the detection host, and the shared approval token.
#
# Full runbook: deploy/soar/README.md  (../../deploy/soar/README.md)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Cross-machine link to the detection half (the integration seam) ────────────
# Postgres `alerts` table is the SOURCE OF TRUTH. The detection host must publish
# 5432 (ports: ["5432:5432"]) and firewall it to <SOAR_HOST>.
DATABASE_URL=postgresql://user:pass@<DETECTION_HOST>:5432/soar

# Kafka low-latency trigger (thin `alert.translated` pointer events). Kafka only
# WAKES the orchestrator; it then fetches the full row from Postgres. The detection
# broker MUST advertise its EXTERNAL listener as <DETECTION_HOST> (not localhost),
# else remote consumers connect to the bootstrap then fail on a localhost redirect.
ENABLE_KAFKA_TRIGGER=true
KAFKA_BROKER=<DETECTION_HOST>:9094
SOAR_ALERT_EVENTS_TOPIC=soar_alert_events
SOAR_ALERT_EVENTS_CONSUMER_GROUP=soar_orchestrator
# Postgres polling fallback/replay (always on): picks up rows missed by Kafka.
POLL_INTERVAL_SEC=3
# Alerts are claimed on the main loop (cheap) but processed — enrichment, case
# creation, dispatch — on a worker pool, each with its own short-lived DB
# connection, so one slow alert doesn't delay claiming the next. Raise if
# Cortex/TheHive/Wazuh can sustain more concurrent calls; the main loop and
# Postgres connection count are not bottlenecks at typical settings.
ORCHESTRATOR_WORKER_COUNT=4

# ── Shared approval secret — MUST EXACTLY MATCH the detection dashboard's value ─
# /soar/approve (token-gated, plain HTTP on :8200) triggers REAL endpoint
# enforcement, so it is authenticated. Generate once with:  openssl rand -base64 32
# Put the SAME value in the detection side's .env (the dashboard sends it as a
# Bearer token to http://<SOAR_HOST>:8200/soar/approve).
SOAR_APPROVAL_TOKEN=__GENERATE_WITH: openssl rand -base64 32__
APPROVAL_TTL_SEC=1800

# ── Severity bands (Step 2) — KEEP ALIGNED with the detection translator ───────
# Deployment uses High>=0.80 because the NFStream model rarely scores >=0.90, and
# the High cell is the only one that emits a gated block -> the approval loop would
# otherwise never fire. The translator's advisory severity_label must use the SAME
# bands (its SEVERITY_HIGH_MIN / SEVERITY_MED_MIN). Spec default is High>=0.90.
SEVERITY_HIGH_THRESHOLD=0.80
SEVERITY_MEDIUM_THRESHOLD=0.70

# ── Runtime / policy gates ─────────────────────────────────────────────────────
ORCHESTRATOR_DRY_RUN=false          # true = decide+log only, no real TheHive/Cortex/Shuffle/Wazuh calls
AUTO_RUN_CORTEX=true                # run Cortex/MISP enrichment (pre-case)
REQUIRE_MAPPED_FOR_THEHIVE=true     # only create cases for MITRE-mapped alerts
REQUIRE_STRICT_MAPPED=true          # accept only mapping_status=mapped (false = also heuristic/unmapped)
SKIP_PRIVATE_IP_OBSERVABLES=true    # skip non-global (RFC1918) IP observables (no external intel value)
MAPPING_TRUST_MIN_CONFIDENCE=0.75   # below this, a TTP is "tentative" — never alone justifies auto-block
# Named allowlist of intel-grade analyzers whose `malicious` verdict can confirm
# an IOC for the High+confirmed auto-block cell (NOT "any analyzer says malicious").
INTEL_CONFIRMATION_ANALYZERS=MISP_2_1,VirusTotal_GetReport_3_1,URLhaus_2_0
# EMIT_ISOLATE_FOR_MANAGED_ENDPOINT=true   # (optional) offer gated isolate when an agent_id is present

# ── TheHive (case management) ──────────────────────────────────────────────────
THEHIVE_BASE_URL=http://<SOAR_HOST>:9000/thehive
THEHIVE_ORGANISATION=AEGIS          # org slug sent as X-Organisation — MUST match the API key's org
THEHIVE_API_KEY=__THEHIVE_API_KEY__ # TheHive user API key (the user must belong to THEHIVE_ORGANISATION)
THEHIVE_CORTEX_ID=Cortex            # TheHive's Cortex connector id/name
THEHIVE_TLP=2
THEHIVE_PAP=2
CREATE_THEHIVE_TASKS=true
THEHIVE_PROCEDURE_RETRIES=3
THEHIVE_PROCEDURE_BACKOFF_MS=500

# ── Cortex (analyzers) + MISP (threat-intel, incl. ja3) ────────────────────────
CORTEX_BASE_URL=http://<SOAR_HOST>:9001/cortex
CORTEX_API_KEY=__CORTEX_API_KEY__   # Cortex API key (org-admin in the analyze org to activate analyzers)
# Analyzers per observable type (comma-separated). Activate them with
# scripts/setup_soar_integrations.py. ja3 is MISP-only.
CORTEX_IP_ANALYZERS=Cyberprotect_ThreatScore_3_0
CORTEX_DOMAIN_ANALYZERS=MISP_2_1
CORTEX_URL_ANALYZERS=MISP_2_1
CORTEX_HASH_ANALYZERS=MISP_2_1
CORTEX_JA3_ANALYZERS=MISP_2_1
CORTEX_WAIT_SECONDS=5
# Max simultaneous Cortex job-launch POSTs across ALL orchestrator workers.
# Prevents (workers x analyzers x observables) launches from saturating the
# Cortex job queue, which made enrichment latency grow linearly with alert_id.
CORTEX_MAX_CONCURRENT=2
CORTEX_PRE_CASE_WAIT_SEC=30         # per-job wait for pre-case enrichment (slow jobs show `pending`)
# Pre-case enrichment launches every analyzer job first, then polls all of
# them in one shared-budget pass (jobs run concurrently in Cortex) instead of
# waiting per-job in sequence. Defaults to CORTEX_PRE_CASE_WAIT_SEC above, so
# existing deployments get the parallelism win automatically; set explicitly
# to bound total enrichment time independent of how many analyzers run.
CORTEX_PRE_CASE_TOTAL_BUDGET_SEC=30
MAX_CORTEX_RUNS_PER_FLOW=8
POST_CORTEX_SUMMARY_TASK=true
CORTEX_SUMMARY_PER_JOB_WAIT_SEC=2
CORTEX_SUMMARY_TOTAL_BUDGET_SEC=20

MISP_URL=http://<SOAR_HOST>:8088
MISP_API_KEY=__MISP_API_KEY__
MISP_NAME=thesis-misp
MISP_CERT_CHECK=false

# Tier-1 Cortex analyzer keys (external services; free signup). Leave blank to
# skip that analyzer. setup_soar_integrations.py injects whichever are set.
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=
URLSCAN_API_KEY=
MALTIVERSE_API_KEY=
# MAXMIND_LICENSE_KEY=

# ── Responders / case automation ───────────────────────────────────────────────
AUTO_LINK_CASE_PROCEDURES=true
AUTO_RUN_RESPONDERS=true
AUTO_COMPLETE_CASE_TASKS=false
RUN_RESPONDERS_ON_ALL=false
RESPONDER_MATCH_MODE=all
MAX_RESPONDERS_PER_FLOW=10
FORCE_ACTIVE_RESPONSE=false
ACTIVE_RESPONSE_MIN_PROBA=0.80
PLAYBOOK_MAX_TECHNIQUES=5

# ── Shuffle (records the §7.1 directive; gate retired — orchestrator owns it) ──
SHUFFLE_BASE_URL=http://<SOAR_HOST>:3001
SHUFFLE_API_KEY=__SHUFFLE_API_KEY__
SHUFFLE_WORKFLOW_ID=77913ca2-11ce-4870-9eaf-6ce2ba545374   # importable: services/soar_orchestrator/shuffle/
# callback_url Shuffle POSTs results to (/soar/shuffle-result). Must be reachable
# from the Shuffle worker — use the host IP, not a container name.
SOAR_CALLBACK_BASE_URL=http://<SOAR_HOST>:8200
ORCHESTRATOR_HTTP_PORT=8200

# ── Notify → Slack (orchestrator-side, fail-soft) ──────────────────────────────
SLACK_WEBHOOK_URL=__SLACK_INCOMING_WEBHOOK_URL__   # blank disables Slack notify
# SLACK_NOTIFY_ENABLED=true
# SLACK_NOTIFY_MIN_SEVERITY=low        # low|medium|high (throttle noisy replays)

# ── Wazuh on-demand Active-Response (endpoint block/isolate) ───────────────────
# Manager runs on THIS host (deploy/soar/wazuh-manager). The orchestrator calls
# PUT /active-response with the ACTIVE-RESPONSE NAME `soar-block0` (registered
# command + Wazuh's "0" timeout suffix) — NOT `soar-block` / `!soar-block`.
WAZUH_API_URL=https://<SOAR_HOST>:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=__WAZUH_API_PASSWORD__   # MUST match API_PASSWORD in deploy/soar/wazuh-manager
WAZUH_VERIFY_TLS=false               # self-signed manager cert
WAZUH_AR_ENABLED=true
# WAZUH_AR_COMMAND_PREFIX=            # empty (default): send the AR name "soar-block0"

# ── MITRE ATT&CK STIX cache (in-container) ─────────────────────────────────────
ATTACK_STIX_CACHE_PATH=/app/cache/enterprise-attack.json
ATTACK_STIX_CACHE_MAX_AGE_SEC=604800

# ── Observability ──────────────────────────────────────────────────────────────
METRICS_PORT=9100
LOG_FORMAT=json
LOG_LEVEL=INFO
