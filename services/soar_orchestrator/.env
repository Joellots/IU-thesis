DATABASE_URL=postgresql://user:pass@postgres:5432/soar

# TheHive integration
# TheHive is running from a separate docker-compose project now.
# From inside containers, localhost points to the container itself, so we use host.docker.internal.
# StrangeBee Docker stack exposes TheHive under the /thehive path.
# The orchestrator calls endpoints like ${THEHIVE_BASE_URL}/api/v1/case.
THEHIVE_BASE_URL=http://172.31.80.148:9000/thehive
THEHIVE_ORGANISATION=demo
THEHIVE_PAP=2
ORCHESTRATOR_DRY_RUN=false
THEHIVE_TLP=2
THEHIVE_CORTEX_ID=Cortex

# Cortex external stack on host
CORTEX_BASE_URL=http://172.31.80.148:9001/cortex
CORTEX_IP_ANALYZERS=Abuse_Finder_3_0,MaxMind_GeoIP_4_0,DShield_lookup_1_0,TeamCymruMHR_1_0,GoogleDNS_resolve_1_0_0
CORTEX_DOMAIN_ANALYZERS=Abuse_Finder_3_0,Maltiverse_Report_1_0,DomainMailSPFDMARC_1_1,Threatcrowd_1_0
CORTEX_URL_ANALYZERS=URLhaus_2_0,UnshortenLink_1_2,Fortiguard_URLCategory_2_1,Urlscan_io_Search_0_1_1
CORTEX_HASH_ANALYZERS=CIRCLHashlookup_1_1,FileInfo_8_0
CORTEX_WAIT_SECONDS=5

# Playbook tuning
PLAYBOOK_MAX_TECHNIQUES=5
ACTIVE_RESPONSE_MIN_PROBA=0.80
FORCE_ACTIVE_RESPONSE=false
RUN_RESPONDERS_ON_ALL=false
RESPONDER_MATCH_MODE=all
MAX_RESPONDERS_PER_FLOW=10
CREATE_THEHIVE_TASKS=true
POLL_INTERVAL_SEC=3
REQUIRE_MAPPED_FOR_THEHIVE=true
REQUIRE_STRICT_MAPPED=true

# Automated case actions
AUTO_LINK_CASE_PROCEDURES=true
AUTO_RUN_RESPONDERS=true
AUTO_RUN_CORTEX=true
AUTO_COMPLETE_CASE_TASKS=false

# Procedure-link resilience
THEHIVE_PROCEDURE_RETRIES=3
THEHIVE_PROCEDURE_BACKOFF_MS=500

# Cortex enrichment summary task on the case
POST_CORTEX_SUMMARY_TASK=true
CORTEX_SUMMARY_PER_JOB_WAIT_SEC=2
CORTEX_SUMMARY_TOTAL_BUDGET_SEC=20

# MITRE ATT&CK STIX cached
ATTACK_STIX_CACHE_PATH=/app/cache/enterprise-attack.json
ATTACK_STIX_CACHE_MAX_AGE_SEC=604800

# Observability
METRICS_PORT=9100
LOG_FORMAT=json
LOG_LEVEL=INFO

# API Keys
THEHIVE_API_KEY=6LcVFQuPNxhPsw6esuHux4O31TORiMGI
THEHIVE_ORGANISATION=XAI
CORTEX_API_KEY=PK5y+Zag++uMhR+CiZl7McC9FVxIUR+Y
MISP_URL=http://host.docker.internal:8088
MISP_API_KEY=thesisMispLabKey0123456789abcdefghij1234
MISP_NAME=thesis-misp
MISP_CERT_CHECK=false