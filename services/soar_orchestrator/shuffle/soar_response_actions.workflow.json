    {
      "app_name": "Shuffle Tools",
      "app_version": "1.2.0",
      "description": "",
      "app_id": "c697b47a-d80e-4dce-999d-787fad4bad7a",
      "errors": [],
      "id": "a2222222-2222-4222-8222-222222222222",
      "is_valid": true,
      "sharing": true,
      "label": "execute_direct",
      "public": true,
      "generated": false,
      "large_image": "data:image/png;base64,",
      "environment": "Shuffle",
      "name": "execute_python",
      "parameters": [
        {
          "description": "",
          "id": "",
          "name": "code",
          "example": "",
          "value": "import json\nimport urllib.request\ndata = json.loads(\"\"\"$exec\"\"\")\nAPPROVAL_OUTCOME = \"auto\"\n\nalert = data.get(\"alert\") or {}\ncase = data.get(\"case\") or {}\nactions = data.get(\"actions\") or []\nresults = []\n\nfor action in actions:\n    atype = action.get(\"type\")\n    if atype == \"notify\":\n        results.append({\"type\": \"notify\", \"outcome\": \"executed\",\n                        \"channels\": action.get(\"channels\") or [],\n                        \"detail\": \"Notification dispatched (placeholder) for flow %s severity %s\"\n                                  % (alert.get(\"flow_id\", \"\"), alert.get(\"severity\", \"\"))})\n    elif atype == \"block\":\n        # SAFE no-op placeholder: record the block, never enact a firewall change.\n        results.append({\"type\": \"block\", \"outcome\": \"executed\", \"enforced\": False,\n                        \"placeholder\": True, \"requires_approval\": bool(action.get(\"requires_approval\")),\n                        \"approval_outcome\": APPROVAL_OUTCOME,\n                        \"targets\": action.get(\"targets\") or [],\n                        \"detail\": \"BLOCK placeholder - no real firewall change performed\"})\n    elif atype == \"isolate\":\n        # SAFE no-op placeholder: isolate is NEVER actually enacted.\n        results.append({\"type\": \"isolate\", \"outcome\": \"executed\", \"enforced\": False,\n                        \"placeholder\": True, \"approval_outcome\": APPROVAL_OUTCOME,\n                        \"target\": action.get(\"target\"),\n                        \"detail\": \"ISOLATE placeholder - endpoint never actually isolated\"})\n    else:\n        results.append({\"type\": atype, \"outcome\": \"skipped\", \"reason\": \"unknown action type\"})\n\ncallback_url = data.get(\"callback_url\", \"\")\nbody = json.dumps({\n    \"flow_id\": alert.get(\"flow_id\", \"\"),\n    \"thehive_case_id\": case.get(\"thehive_case_id\", \"\"),\n    \"approval_outcome\": APPROVAL_OUTCOME,\n    \"results\": results,\n})\n\ncallback = {\"attempted\": False}\nif callback_url:\n    callback[\"attempted\"] = True\n    req = urllib.request.Request(callback_url, data=body.encode(\"utf-8\"),\n                                 headers={\"Content-Type\": \"application/json\"}, method=\"POST\")\n    try:\n        with urllib.request.urlopen(req, timeout=10) as resp:\n            callback[\"status\"] = resp.status\n            callback[\"ok\"] = True\n    except Exception as exc:  # network/orchestrator down -> reported, not fatal\n        callback[\"ok\"] = False\n        callback[\"error\"] = str(exc)\n\nprint(json.dumps({\n    \"flow_id\": alert.get(\"flow_id\", \"\"),\n    \"thehive_case_id\": case.get(\"thehive_case_id\", \"\"),\n    \"approval_outcome\": APPROVAL_OUTCOME,\n    \"results\": results,\n    \"callback_url\": callback_url,\n    \"callback\": callback,\n}))",
