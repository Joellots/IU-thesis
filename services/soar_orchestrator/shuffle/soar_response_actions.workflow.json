      "environment": "Shuffle",
      "name": "execute_python",
      "parameters": [
        {
          "description": "",
          "id": "",
          "name": "code",
          "example": "",
          "value": "import json\ndata = json.loads(\"\"\"$exec\"\"\")\n\nblock_present = bool(data.get(\"block_present\"))\nisolate_present = bool(data.get(\"isolate_present\"))\nnotify_present = bool(data.get(\"notify_present\"))\nblock_gated = bool(data.get(\"block_requires_approval\"))\nisolate_gated = bool(data.get(\"isolate_requires_approval\"))\n\n# A human must approve before ANY enforcement runs when a gated block or\n# (always-gated) isolate is in the directive. Notify is never gated.\napproval_required = (block_present and block_gated) or (isolate_present and isolate_gated)\n\nalert = data.get(\"alert\") or {}\ncase = data.get(\"case\") or {}\nprint(json.dumps({\n    \"flow_id\": alert.get(\"flow_id\", \"\"),\n    \"severity\": alert.get(\"severity\", \"\"),\n    \"thehive_case_id\": case.get(\"thehive_case_id\", \"\"),\n    \"callback_url\": data.get(\"callback_url\", \"\"),\n    # GATE RETIRED: gated block/isolate now go to the dashboard approval loop\n    # (orchestrator soar_pending_approvals + POST /soar/approve), not this\n    # Shuffle User-Input node. Always route to execute_direct (record + callback).\n    \"approval_required\": \"false\",\n    \"block_present\": \"true\" if block_present else \"false\",\n    \"isolate_present\": \"true\" if isolate_present else \"false\",\n    \"notify_present\": \"true\" if notify_present else \"false\",\n}))",
          "multiline": false,
          "multiselect": false,
          "options": null,
