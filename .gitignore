# Secrets — never commit the real .env; the documented template IS committed.
.env*
!.env.example

# Data: ignore everything EXCEPT the small labelled demo set the pipeline replays.
# (data/dataset.csv is 1.9 GB — must stay out.)
data/*
!data/training_dataset.csv

eval_results*
docs/

# Models: ship the trained mapper (≈50 MB) so inference runs out-of-the-box.
models/*
!models/mapper

__pycache__/
services/nfstream/output/*

# Ignore all PCAPs/derived data, but keep the IOC manifest (pins the dataset)
pcaps/*
!pcaps/mta/
pcaps/mta/*
!pcaps/mta/ioc_manifest.json

# Generated directory snapshot (regenerated per machine)
tree.txt

# Endpoint-agent build artifacts (regenerated by package.sh; .env covered by .env*)
dist/
endpoint_agent/sensor/app/

# React dashboard build artifacts
services/dashboard-web/node_modules/
services/dashboard-web/dist/

# Endpoint sensor runtime output (captured flows)
endpoint_agent/sensor/output/

# SOAR-side reference snapshot — canonical lives in the SOAR repo; kept local only,
# never pushed from the detection repo. (docs/ is the authoritative shared copy.)
context_soar/

# Handover/generated artifacts — never committed to the detection repo:
#   handover/SOAR/                 a whole separate repo snapshot (may carry secrets)
#   handover/codex_report_bundle/  the generated Codex/ChatGPT report bundle
#   handover/aegis_thesis_context_bundle_*.{tar.gz,zip}  packaged context archives
handover/

thesis/
