# Endpoint NFStream sensor configuration (copied to .env by install.sh).
# ── Detection pipeline (remote) ───────────────────────────────────────────────
KAFKA_BROKER=172.31.87.134:9094      # detection host's EXTERNAL Kafka listener
TOPIC=raw_flows

# ── Capture ───────────────────────────────────────────────────────────────────
INTERFACE=                            # e.g. eth0; empty = capture "any" interface
BPF_FILTER=tcp port 443 or udp port 443 or tcp port 465 or tcp port 993 or tcp port 995 or tcp port 853
IDLE_TIMEOUT=15
ACTIVE_TIMEOUT=120

# ── Endpoint identity (stamped onto every flow → SOAR response routing) ───────
AGENT_ID=                             # Wazuh agent id (install.sh fills from client.keys)
HOST_ID=                              # Wazuh agent name = host id (defaults to hostname)
HOST_IP=                              # this host's IP (auto-detected if empty)
